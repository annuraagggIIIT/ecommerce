{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "tests/**",
    "**/*.d.ts",
    "src/index.ts",
    "src/db/prisma.ts",
    "src/routes/**",
    "src/secrets.ts",
    "src/controllers/**",
    "src/middlewares/auth.ts"
  ],
  "reporter": [
    "text",
    "lcov"
  ],
  "report-dir": "coverage"
}
